<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="ebox2_pu" transaction-type="RESOURCE_LOCAL">
        <class>com.notamethod.fluppy.core.game.GameEntity</class>
        <class>com.notamethod.fluppy.core.game.GenreEntity</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:~/.fluppy/data/ebdb2"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.connection.pool_size" value="1"/>
        </properties>
    </persistence-unit>
</persistence>
