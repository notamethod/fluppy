<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.session.metrics" level="ERROR"/>
    <logger name="org.hibernate.HQL_FUNCTIONS" level="ERROR"/>
    <logger name="com.notamethod.fluppy.gui" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
